FROM sapmachine:25

ARG MC_VERSION=26.1.1
ARG PAPER_BUILD=29

RUN apt-get update && apt-get install -y curl ca-certificates jq && rm -rf /var/lib/apt/lists/*

RUN curl -L "$(curl -L -s https://fill.papermc.io/v3/projects/paper/versions/${MC_VERSION}/builds/${PAPER_BUILD} | jq -r '.downloads."server:default".url')" -o /tmp/papermc.jar

COPY entrypoint.sh /opt/entrypoint.sh
RUN chmod +x /opt/entrypoint.sh

EXPOSE 25565/tcp
EXPOSE 24454/udp

ENTRYPOINT ["/bin/bash", "-c", "/opt/entrypoint.sh"]
