FROM steamcmd/steamcmd:latest

# Install steamcmd and game dependencies
RUN dpkg --add-architecture i386 \
    && apt-get update \
    && apt-get install -y libstdc++6:i386 libgcc1:i386 libcurl4-gnutls-dev \
    && rm -rf /var/lib/apt/lists/*

# Install game server
# This step may fail a few times; no extra action is needed, just try building the image again.
RUN steamcmd +login anonymous +app_update 343050 validate +quit || \
    steamcmd +login anonymous +app_update 343050 validate +quit || \
    steamcmd +login anonymous +app_update 343050 validate +quit

# Setup entrypoint script
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Copy server configuration
COPY ./servercfg /servercfg

# Setup entrypoint
ENTRYPOINT ["/entrypoint.sh"]
