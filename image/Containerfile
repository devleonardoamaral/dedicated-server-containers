ARG JAVA_VERSION

FROM sapmachine:${JAVA_VERSION}

ARG MINECRAFT_VERSION
ARG PAPER_BUILD

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl ca-certificates jq \
    && rm -rf /var/lib/apt/lists/*

RUN curl -L "$(curl -L -s https://fill.papermc.io/v3/projects/paper/versions/${MINECRAFT_VERSION}/builds/${PAPER_BUILD} \
    | jq -r '.downloads."server:default".url')" -o /tmp/papermc.jar

COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 25565/tcp
EXPOSE 24454/udp

ENTRYPOINT [ "/entrypoint.sh" ]
